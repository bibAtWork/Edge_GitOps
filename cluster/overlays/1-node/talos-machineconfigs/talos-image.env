# Pinned Talos installer image — the single source of truth for node upgrades.
#
# SCHEMATIC_ID is derived from schematic.yaml, not chosen. It is a content hash of
# the extension list and is INDEPENDENT of TALOS_VERSION -- this same ID resolves
# for v1.12.0 through v1.13.9. Regenerate it when schematic.yaml changes, and only
# then:
#
#   curl -X POST --data-binary @schematic.yaml https://factory.talos.dev/schematics
#
# A TALOS_VERSION bump needs no regeneration. What it does need is a check that the
# Factory has actually built this schematic for the new version, because system
# extensions are published per version and a new release can arrive before they
# are. The Talos image CI workflow does that on every PR touching these files.
#
# Upgrade a node with:
#   talosctl upgrade --nodes <ip> \
#     --image factory.talos.dev/installer/${SCHEMATIC_ID}:${TALOS_VERSION}
#
# Renovate watches TALOS_VERSION (regexManager in renovate.json at the repo root).
# The talos package group is never auto-merged -- not because a human has to
# regenerate anything, but because the upgrade reboots nodes and because a release
# can land before its extension images exist. Both stay a human decision.

TALOS_VERSION=v1.13.9

# Extensions baked in: siderolabs/iscsi-tools, siderolabs/util-linux-tools
# Both required by Longhorn V1 — see docs/adr/0004-longhorn-v1-storage-engine.md
SCHEMATIC_ID=613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245
