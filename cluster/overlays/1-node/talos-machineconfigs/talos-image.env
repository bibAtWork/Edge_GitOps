# Pinned Talos installer image — the single source of truth for node upgrades.
#
# SCHEMATIC_ID is derived from schematic.yaml, not chosen. Regenerate it whenever
# that file changes:
#
#   curl -X POST --data-binary @schematic.yaml https://factory.talos.dev/schematics
#
# and whenever TALOS_VERSION changes, re-check that the schematic still builds for
# the new version before rolling it out.
#
# Upgrade a node with:
#   talosctl upgrade --nodes <ip> \
#     --image factory.talos.dev/installer/${SCHEMATIC_ID}:${TALOS_VERSION}
#
# Renovate watches TALOS_VERSION (see .github/renovate.json5); a bump there must be
# followed by regenerating SCHEMATIC_ID, which is why they live in one file.

TALOS_VERSION=v1.13.6

# Extensions baked in: siderolabs/iscsi-tools, siderolabs/util-linux-tools
# Both required by Longhorn V1 — see docs/adr/0004-longhorn-v1-storage-engine.md
SCHEMATIC_ID=613e1592b2da41ae5e265e8789429f22e121aab91cb4deb6bc3c0b6262961245
