{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "baseBranchPatterns": [
    "ops/talos_linux"
  ],
  "labels": ["renovate"],
  "minimumReleaseAge": "48 hours",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": ["renovate", "security"]
  },
  "osvVulnerabilityAlerts": true,
  "flux": {
    "enabled": true,
    "managerFilePatterns": [
      "/cluster/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/cluster/.+helmrelease\\.yaml$/"
    ]
  },
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": [
      "/cluster/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Ansible tool versions in group_vars/all.yml (comment-driven)",
      "managerFilePatterns": ["/bootstrap/ansible/group_vars/all\\.yml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\w+_version:\\s*\"(?<currentValue>[\\d.]+)\""],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Talos installer pin in talos-image.env. Source of truth for manual node upgrades; the SUC plan below covers the automated path and the two must not drift. A bump here REQUIRES regenerating SCHEMATIC_ID from schematic.yaml via the Image Factory, which Renovate cannot do -- hence the talos group is never auto-merged.",
      "managerFilePatterns": ["/cluster/overlays/.+/talos-machineconfigs/talos-image\\.env$/"],
      "matchStrings": ["TALOS_VERSION=(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "description": "Talos version in SUC upgrade plans (spec.version drives the installer tag via SYSTEM_UPGRADE_PLAN_LATEST_VERSION)",
      "managerFilePatterns": ["/cluster/base/infrastructure/15-system-upgrade-controller/config/plans/.+\\.yaml$/"],
      "matchStrings": ["version:\\s*(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "description": "talosctl image inside the SUC upgrade plans. This is the TOOL that performs the upgrade, not the target version, and it had no manager at all -- which is why it sat two and three patch releases behind spec.version while both were supposedly kept in step. Grouped with siderolabs/talos so the tool and the target move together.",
      "managerFilePatterns": ["/cluster/base/infrastructure/15-system-upgrade-controller/config/plans/.+\\.yaml$/"],
      "matchStrings": ["image:\\s*ghcr\\.io/siderolabs/talosctl:(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/talosctl"
    },
    {
      "customType": "regex",
      "description": "Factory installer tag in the machine configs. Decides which Talos a rebuilt node installs, so leaving it behind talos-image.env means a rebuild lands on the old version and needs an immediate upgrade. The SCHEMATIC_ID in the same string is NOT tracked and must still be regenerated by hand whenever the schematic changes.",
      "managerFilePatterns": ["/cluster/overlays/.+/talos-machineconfigs/controlplane\\.yaml$/"],
      "matchStrings": ["image:\\s*factory\\.talos\\.dev/installer/[0-9a-f]+:(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    }
  ],
  "packageRules": [
    {
      "description": "Group all Talos ecosystem updates into one PR",
      "matchPackageNames": ["siderolabs/talos", "ghcr.io/siderolabs/talosctl"],
      "groupName": "talos",
      "automerge": false
    },
    {
      "description": "Label major updates — CI workflow uses this to skip Trivy auto-merge",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false
    },
    {
      "description": "Label minor/patch updates — CI Trivy gate evaluates auto-merge eligibility",
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["minor-update"],
      "automerge": false
    },
    {
      "description": "Disable digest updates for Talos images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": false,
      "matchPackageNames": [
        "/siderolabs/*/"
      ]
    },
    {
      "description": "Group Flux updates",
      "groupName": "flux",
      "automerge": false,
      "matchPackageNames": [
        "/fluxcd/*/",
        "/flux2/"
      ]
    },
    {
      "description": "Route all patch updates through Trivy gate (no Renovate-side automerge)",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "external-dns",
        "stakater/reloader",
        "trivy-operator"
      ],
      "automerge": false
    }
  ]
}
