{
  "_readme": "Copy this file to bootstrap/config.json (gitignored), fill in all values, then run bootstrap-1node.sh. The script reads from this file — no manual YAML editing needed.",

  "cluster": {
    "name": "homelab",
    "letsencrypt_email": "",
    "domain": "",
    "subdomain": "",
    "_gateway_ip_comment": "A free LAN IP for the gateway (e.g. node_ip with last octet 200). Cilium announces it via ARP so domain names resolve on the LAN.",
    "gateway_ip": ""
  },

  "node": {
    "_comment": "ip is read by bootstrap-1node.sh; ip1/ip2/ip3/vip are read by bootstrap-3node.sh. Fill in only the ones your profile needs -- the other script ignores fields it doesn't read. subnet is shared by both.",
    "ip": "",
    "ip1": "",
    "ip2": "",
    "ip3": "",
    "vip": "",
    "subnet": "192.168.1.0/24"
  },

  "github": {
    "owner": "",
    "repo": "",
    "branch": "main",
    "token": ""
  },

  "aws": {
    "region": "eu-central-1",
    "access_key_id": "",
    "secret_access_key": ""
  },

  "cloudflare": {
    "api_token": ""
  },

  "tailscale": {
    "oauth_client_id": "",
    "oauth_client_secret": ""
  },

  "seaweedfs": {
    "_comment": "Leave empty to auto-generate random credentials on first run.",
    "admin_access_key_id": "",
    "admin_secret_access_key": ""
  },

  "flux_notifications": {
    "_comment": "GitHub PAT with repo:status scope only — used by Flux to post commit status on reconciliation failure.",
    "github_status_token": ""
  },

  "grafana": {
    "admin_password": ""
  },

  "zot": {
    "_comment": "Leave empty to auto-generate a random password on first run.",
    "admin_password": ""
  },

  "etcd": {
    "_comment": "Leave empty to auto-generate a random AES-256-CBC key for etcd secrets encryption at rest. Once set, DO NOT change — rotating requires re-encrypting all etcd secrets with: kubectl get secrets -A -o json | kubectl replace -f -",
    "encryption_key": ""
  },

  "keycloak": {
    "_comment": "Leave grafana_client_secret empty to auto-generate. This is the shared secret for Grafana's Keycloak OIDC client — apply-config.py writes it into Grafana's oauth secret only; the matching value in 26-keycloak/keycloak-secret.yaml (Keycloak's own realm-config Secret) is not generated by this script and must be kept in sync by hand (see docs/backlog.md).",
    "grafana_client_secret": ""
  }
}
