FROM node:22-bookworm-slim
ARG OPENCODE_VERSION=1.18.34
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g opencode-ai@${OPENCODE_VERSION}
WORKDIR /opt/kube-agent
COPY app ./app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/agent
USER 10001:10001
ENTRYPOINT ["python3", "-m", "app.worker"]
